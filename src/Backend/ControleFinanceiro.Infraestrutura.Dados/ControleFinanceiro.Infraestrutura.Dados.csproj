<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infraestrutura de dados: implementa os contratos da Aplicação com Dapper + Npgsql. -->
  <PropertyGroup>
    <RootNamespace>ControleFinanceiro.Infraestrutura.Dados</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControleFinanceiro.Aplicacao\ControleFinanceiro.Aplicacao.csproj" />
  </ItemGroup>

  <!-- Os scripts viajam dentro do assembly: o binário publicado carrega as migrações consigo. -->
  <ItemGroup>
    <EmbeddedResource Include="Migracoes\Scripts\*.sql" />
    <EmbeddedResource Include="Migracoes\ScriptsDeExemplo\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
